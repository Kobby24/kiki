APP_NAME=Sikapa API
ENVIRONMENT=development
DEBUG=true

# --- Database -----------------------------------------------------------
# SQLAlchemy async connection string. If you're on Supabase Postgres, this
# is NOT the SUPABASE_URL below (that's the REST/Auth API endpoint) — use
# the Postgres connection string from Supabase's Database settings page,
# with the asyncpg driver, e.g.:
# postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=
# Only needed if/when the app calls Supabase's REST or Auth APIs directly
# (e.g. via supabase-py). Not currently read by the app — DATABASE_URL
# above is what the app actually connects with.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth / JWT -----------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OTP (phone number + code) authentication ------------------------------
# Length of generated numeric codes.
OTP_LENGTH=6
# How long a code stays valid after it's sent.
OTP_TTL_SECONDS=300
# Wrong-code guesses allowed before a code is locked (caller must request a new one).
OTP_MAX_ATTEMPTS=5
# Minimum wait between two OTP requests for the same phone number/purpose.
OTP_RESEND_COOLDOWN_SECONDS=60
# Max OTP requests allowed per phone number/purpose in a rolling hour.
OTP_MAX_REQUESTS_PER_HOUR=5
# When true AND ENVIRONMENT != production, OTP request responses include
# the plaintext code (debug_code) so you can test without a live SMS
# provider. MUST be false (or ENVIRONMENT=production) in production.
OTP_DEBUG_EXPOSE_CODE=true

# --- SMS delivery (OTP codes) ----------------------------------------------
# "simulation" (no real SMS sent, code is logged + returned as debug_code)
# or "vonage" (send via the Vonage SMS API — requires the VONAGE_* values below).
SMS_MODE=simulation
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Approved alphanumeric sender/brand name, or a Vonage virtual number
# (no leading '+'), shown to the recipient as the message sender.
VONAGE_SMS_FROM=Sikapa
VONAGE_SMS_BASE_URL=https://rest.nexmo.com
VONAGE_SMS_TIMEOUT_SECONDS=10

# --- Mobile Money (cash-out) -------------------------------------------
MOMO_MODE=simulation
# Not yet read by the app; the simulator is used whenever MOMO_MODE=simulation.
# Wire these up if/when a live MoMo provider integration is added.
MOMO_API_BASE_URL=
MOMO_API_KEY=
MOMO_API_SECRET=

# --- AI / intent recognition ---------------------------------------------
# Legacy placeholders retained for existing local setups. The communication
# engine reads HCI_LAB_* and CLOUDINARY_* below.
AI_PROVIDER=local
AI_API_KEY=

# --- AI/ML communication engine (ai/) ------------------------------------
# HCI LAB speech API (ASR + TTS). Leave the key empty to disable remote calls;
# local NLU (/ai/extract-intent) still works without it.
HCI_LAB_API_BASE_URL=https://lab-subscription-platform.vercel.app/api/v1
HCI_LAB_API_KEY=
HCI_LAB_TTS_MODEL_TYPE=ss
HCI_LAB_TTS_SPEAKER=PT
HCI_LAB_TIMEOUT_SECONDS=400

# Cloudinary CDN for synthesized audio. Required for /ai/synthesize.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- CORS / misc -----------------------------------------------------------
INTENT_CONFIDENCE_THRESHOLD=0.75
CORS_ORIGINS=["http://localhost:8000", "http://localhost:3000"]
